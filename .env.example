# Database
DATABASE_URL="postgresql://postgres:postgres_password@localhost:5432/stackpulse?schema=public"

# Auth
JWT_SECRET="your-long-random-secret"

# GitHub API Token (Optional but highly recommended for 5,000 req/hr vs 60)
GITHUB_TOKEN=""

# Server Config
PORT=5000
CLIENT_URL="http://localhost:5173"

# GitHub Cache TTL in minutes (default 60 minutes)
CACHE_TTL_MINUTES=60
